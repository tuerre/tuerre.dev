---
import Header from "../components/Header.astro";
import SEO from "../components/SEO.astro";
import "../styles/global.css";
import "@fontsource-variable/onest";

interface Props {
  lang?: "en" | "es";
  title: string;
  description: string;
  currentPage?: string;
  seoType?: "website" | "article";
}

const {
  lang = "en",
  title,
  description,
  currentPage = "",
  seoType = "website",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#00d8ff" />
    <meta name="language" content={lang === "es" ? "Spanish" : "English"} />
    <meta name="geo.region" content="DO" />
    <meta name="geo.placename" content="Dominican Republic" />
    <meta name="rating" content="general" />
    <meta name="distribution" content="global" />
    <meta name="keywords" content="Jendry De León Abreu, Desarrollador Web Full-Stack, República Dominicana Portafolio, React, NodeJS, Web Developer, Dominican Republic" />
    <meta name="google-site-verification" content="EbPOgNvdlarDNR9HF-Vwf3JBZlBYn-lsqw7lZXQIg0k" />
    <title>{title}</title>
    <SEO
      title={title}
      description={description}
      lang={lang}
      currentPage={currentPage}
      type={seoType}
    />
  </head>
  <body class="relative text-[#F1F1F1]">
    <div
      class="absolute top-0 bottom-0 min-h-screen w-full -z-10 bg-gray-950 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
    ></div>
    <Header lang={lang} currentPage={currentPage} />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --nav-shadow-bg: rgba(30, 30, 35, 0.75);
    color-scheme: dark;
  }

  html {
    font-family: "Onest Variable", system-ui, sans-serif;
    scroll-behavior: smooth;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    overscroll-behavior: none;
    overflow-x: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  ::selection {
    background-color: rgba(255, 255, 255, 0.078);
  }
</style>

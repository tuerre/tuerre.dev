---
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Proyectos from "../components/Proyectos.astro";
import Footer from "../components/Footer.astro";

const lang = "en";
---

<Layout
  lang={lang}
  title="Projects - Jendry De León Abreu"
  description="All of Jendry De León Abreu's web development projects. Web applications, management systems, and more."
  currentPage="projects"
>
  <main>
    <SectionContainer class="pt-28 pb-16 relative">
      <div class="max-w-7xl mx-auto px-4 mb-6">
        <a
          href="/"
          class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-[#f2ce5a] transition-colors mb-6"
        >
          ← Home
        </a>
        <h1 class="text-4xl font-bold text-[#F1F1F1] mb-2">
          All Projects
        </h1>
        <p class="text-gray-400">
          A collection of my work and personal projects.
        </p>
      </div>
      <Proyectos lang={lang} />
    </SectionContainer>

    <SectionContainer class="px-3 relative pb-8">
      <Footer />
    </SectionContainer>
  </main>
</Layout>

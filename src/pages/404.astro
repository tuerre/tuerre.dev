---
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
---

<Layout
  lang="en"
  title="404 - Page Not Found | Jendry De León Abreu"
  description="The page you are looking for was not found."
>
  <SectionContainer class="relative top-[50vh] translate-y-[-50%]">
    <main class="flex flex-col gap-3 items-center justify-center">
      <div class="flex justify-center mb-8">
        <div class="relative">
          <div
            class="absolute inset-0 bg-gradient-to-r from-red-500/20 to-orange-500/20 rounded-full blur-xl"
          >
          </div>
          <img
            loading="lazy"
            class="aspect-[480/266] w-full h-auto block"
            src="/images/this-is-fine-404.gif"
            alt="This is fine meme"
          />
        </div>
      </div>

      <h3 class="font-normal text-2xl text-gray-800 dark:text-[#F1F1F1]">
        error <span class="font-bold">404</span>
      </h3>
      <span class="text-gray-600 dark:text-gray-300"
        >The page you're looking for was not found...</span
      >
      <a href="/en/" class="underline text-[#f2ce5a] hover:text-[#f2ce5a]/70"
        >Back to home</a
      >
    </main>
  </SectionContainer>
</Layout>

---
import Layout from "../layouts/Layout.astro";

const lang = "en";
const pdfPath = "/JendryDeLeonAbreu-EN.pdf";
---

<Layout
  lang={lang}
  title="Resume - Jendry De León Abreu"
  description="Resume of Jendry De León Abreu, Full-Stack Web Developer from the Dominican Republic."
  currentPage="resume"
  seoType="article"
>
  <main class="flex flex-col h-screen pt-14">
    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-800 bg-gray-950/80 backdrop-blur-sm">
      <div class="flex items-center gap-3">
        <a
          href="/"
          class="text-sm text-gray-400 hover:text-[#f2ce5a] transition-colors"
        >
          ← Home
        </a>
        <span class="text-gray-700">/</span>
        <h1 class="text-sm font-semibold text-[#F1F1F1]">
          Resume
        </h1>
      </div>
      <a
        href={pdfPath}
        download="JendryDeLeonAbreu-EN.pdf"
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#f2ce5a] text-gray-900 font-semibold text-sm hover:bg-[#f2ce5a]/80 transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download Resume
      </a>
    </div>

    <div class="flex-1 relative">
      <iframe
        src={pdfPath}
        class="w-full h-full border-0"
        title="Jendry De León Abreu - Resume"
      >
        <p class="p-8 text-gray-400">
          Your browser doesn't support PDF preview.
          <a href={pdfPath} class="text-[#f2ce5a] underline" download>
            Download the PDF here.
          </a>
        </p>
      </iframe>
    </div>
  </main>
</Layout>

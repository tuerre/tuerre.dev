---
import ButtonDashed from "./ButtonDashed.astro";
import { projects } from "../data/projects";
import { t, getLangBase } from "../i18n/utils";
import type { Lang } from "../i18n/translations";

interface Props {
  lang?: Lang;
  limit?: number;
  showAllLink?: boolean;
}

const { lang = "en", limit, showAllLink = false } = Astro.props;
const base = getLangBase(lang);
const displayed = limit ? projects.slice(0, limit) : projects;
---

<div class="max-w-7xl mx-auto px-4 mt-20 md:mt-0">
  <div class="max-w-7xl">
    <h2 class="text-[#f2ce5a] font-bold text-[27px] mb-2">
      {t(lang, "projects.title")}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        displayed.map((project) => (
          <div class="flex flex-col gap-0.5 border border-gray-500/70 rounded-lg p-4 h-full bg-transparent backdrop-blur-sm">
            <h3 class="font-medium text-xl text-[#F1F1F1]">
              {lang === "es" ? project.title : project.titleEn}
            </h3>
            <div>
              <ul class="flex flex-wrap gap-2 mt-1">
                {project.languages.map((lenguaje) => (
                  <li class="flex">
                    <span class="flex items-center gap-2 rounded-full text-xs bg-[#003159] text-white py-1 px-2.5">
                      {lenguaje}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="mt-3 flex-grow">
              <p class="text-gray-300 text-sm leading-relaxed">
                {lang === "es" ? project.description : project.descriptionEn}
              </p>
            </div>
            <div class="flex gap-2 mt-4">
              <ButtonDashed url={project.url} label={t(lang, "projects.code")} />
              {project.demoURL && (
                <ButtonDashed
                  url={project.demoURL}
                  label={t(lang, "projects.preview")}
                  icon={false}
                />
              )}
            </div>
          </div>
        ))
      }
    </div>

    {
      showAllLink && (
        <div class="flex justify-center mt-8">
          <a
            href={`${base}/projects`}
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full border-2 border-[#f2ce5a]/60 text-[#f2ce5a] font-semibold text-sm hover:bg-[#f2ce5a]/10 transition-colors"
          >
            {t(lang, "projects.viewAll")}
          </a>
        </div>
      )
    }
  </div>
</div>

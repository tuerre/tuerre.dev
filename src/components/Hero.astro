---
import MailIcon from "./icons/Mail.astro";
import GitHubIcon from "./icons/GitHub.astro";
import SiteIcon from "./icons/Site.astro";
import LinkedInIcon from "./icons/LinkedIn.astro";
import { t } from "../i18n/utils";
import type { Lang } from "../i18n/translations";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
---

<div class="max-w-7xl mx-auto px-4 pt-12">
  <div class="max-w-xl">
    <div class="flex items-center gap-4 mb-4">
      <div class="relative max-w-24 max-h-24">
        <img
          loading="eager"
          class="rounded-full shadow-lg size-24 select-none"
          src="/me.webp"
          alt="Foto Selfie de Jendry De Leon"
          width="96"
          height="96"
        />
      </div>
      <div class="flex flex-col">
        <h1 class="text-[25px] font-bold text-[#F1F1F1] sm:text-4xl">
          Jendry De León Abreu
        </h1>
        <div class="flex items-center gap-2 mt-0.5 text-gray-300">
          <SiteIcon />
          <span class="text-[13px]">{t(lang, "hero.location")}</span>
        </div>
      </div>
    </div>

    <p class="mt-4 text-xl text-[#e8e8e8]">
      {t(lang, "hero.tagline")}
      <strong class="font-bold text-[#09f]">
        {t(lang, "hero.highlight")}
      </strong>
      {" "}{t(lang, "hero.suffix")}
    </p>

    <nav
      class="w-full flex flex-wrap md:flex-row md:flex-nowrap items-center gap-4 mt-5 select-none"
    >
      <a
        target="_blank"
        href="mailto:tuerredev@gmail.com"
        class="w-full flex items-center justify-center gap-2 font-medium text-[16px] px-[50px] py-[10px] rounded-full bg-gradient-to-r from-[#213f67] to-[#1b1e2c] via-[#1c2438] transition-all duration-200 text-[#F1F1F1] border-[2px] border-[#2f5675] hover:brightness-[0.85]"
        title="Enviar Mail a Jendry Abreu"
      >
        <MailIcon />
        {t(lang, "hero.contact")}
      </a>
      <div class="flex w-full items-center gap-3">
        <a
          target="_blank"
          href="https://github.com/tuerre"
          class="w-full flex items-center justify-center gap-2 font-medium text-[16px] px-[50px] py-[10px] rounded-full bg-gradient-to-r from-[#1b1e2c] via-[#1c2438] to-[#213f67] transition-all duration-200 text-[#F1F1F1] border-[2px] border-[#2f5675] hover:brightness-[0.85]"
          title="Mi perfil de GitHub"
        >
          <GitHubIcon />
          {t(lang, "hero.github")}
        </a>
        <a
          target="_blank"
          href="https://linkedin.com/in/tuerre"
          class="transition-all duration-200 hover:brightness-[0.85]"
          title="Perfil de LinkedIn de Jendry Abreu"
        >
          <LinkedInIcon />
        </a>
      </div>
    </nav>
  </div>
</div>

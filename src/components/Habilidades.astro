---
import { iconMap } from "../components/IconMap";
import { t } from "../i18n/utils";
import type { Lang } from "../i18n/translations";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;

const tituloHabilidades = [
  { title: "C++", label: "c++" },
  { title: "C#", label: "csharp" },
  { title: "JavaScript", label: "javascript" },
  { title: "ReactJS", label: "reactjs" },
  { title: "React Native", label: "react-native" },
  { title: "NextJS", label: "nextjs" },
  { title: "NodeJS", label: "nodejs" },
  { title: "TypeScript", label: "typescript" },
  { title: "ExpressJS", label: "expressjs" },
  { title: "SqlServer", label: "sqlserver" },
  { title: "MySQL", label: "mysql" },
  { title: "PostgreSQL", label: "postgresql" },
  { title: "Supabase", label: "supabase" },
  { title: "HTML5", label: "html" },
  { title: "CSS", label: "css" },
  { title: "TailwindCSS", label: "tailwind" },
  { title: "Astro", label: "astro" },
  { title: "Git", label: "git" },
  { title: "GitHub", label: "github" },
  { title: "VSCode", label: "vscode" },
];
---

<div class="max-w-7xl mx-auto px-4 mt-20 md:mt-0">
  <div class="max-w-7xl">
    <h2 class="text-[#f2ce5a] font-bold text-[27px] mb-1">
      {t(lang, "skills.title")}
    </h2>

    <div class="max-w-7xl">
      <ul class="flex flex-wrap gap-2">
        {
          tituloHabilidades.map((hability) => {
            const Icon = iconMap[hability.label];
            return (
              <li>
                <div class="bg-gray-800/30 border border-transparent p-1.5 rounded max-h-9 flex items-center gap-1 [&>svg]:w-4 [&>svg]:h-4">
                  {Icon ? <Icon /> : null}
                  <span class="text-gray-200 text-[14px]">
                    {hability.title}
                  </span>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</div>

---
// JSON-LD estructurado (español-only). Emite un único @graph con la entidad
// Person (site-wide) + el nodo de la página actual, y SOLO en la home añade el
// nodo WebSite (señal del "site name" que muestra Google). En el resto de páginas
// el nodo referencia el WebSite por @id (identificador global; el nodo completo
// vive en la home y los buscadores lo fusionan por @id).
const SITE_URL = "https://tuerre.vercel.app";

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  pageType: "profile" | "collection" | "article" | "webpage";
  image?: string;
  publishedTime?: string;
  tags?: string[];
}

const {
  title,
  description,
  canonicalUrl,
  pageType,
  image,
  publishedTime,
  tags = [],
} = Astro.props;

const inLanguage = "es-DO";

const person = {
  "@type": "Person",
  "@id": `${SITE_URL}/#person`,
  name: "Jendry De León Abreu",
  url: SITE_URL,
  image: `${SITE_URL}/avatar.webp`,
  jobTitle: "Desarrollador Web Full-Stack",
  description:
    "Desarrollador web full stack dominicano de Santo Domingo, República Dominicana, especializado en React, Node.js y TypeScript.",
  nationality: { "@type": "Country", name: "Dominican Republic" },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Santo Domingo",
    addressCountry: "DO",
  },
  knowsAbout: [
    "Web Development",
    "Frontend Development",
    "Backend Development",
    "Mobile Development",
    "Full-Stack Development",
    "React",
    "React Native",
    "Node.js",
    "TypeScript",
    "Astro",
  ],
  sameAs: [
    "https://github.com/tuerre",
    "https://linkedin.com/in/tuerre",
    "https://x.com/tuerredev",
    "https://instagram.com/de1eonzz",
  ],
};

const website = {
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  url: `${SITE_URL}/`,
  name: "Jendry De León Abreu",
  alternateName: "Jendry De León",
  description:
    "Portafolio de Jendry De León Abreu, desarrollador web full stack en República Dominicana.",
  inLanguage,
  publisher: { "@id": `${SITE_URL}/#person` },
};

let pageNode;
if (pageType === "profile") {
  pageNode = {
    "@type": "ProfilePage",
    "@id": `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: title,
    description,
    inLanguage,
    isPartOf: { "@id": `${SITE_URL}/#website` },
    about: { "@id": `${SITE_URL}/#person` },
    mainEntity: { "@id": `${SITE_URL}/#person` },
  };
} else if (pageType === "collection") {
  pageNode = {
    "@type": "CollectionPage",
    "@id": `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: title,
    description,
    inLanguage,
    isPartOf: { "@id": `${SITE_URL}/#website` },
    about: { "@id": `${SITE_URL}/#person` },
  };
} else if (pageType === "article") {
  pageNode = {
    "@type": "BlogPosting",
    "@id": `${canonicalUrl}#webpage`,
    mainEntityOfPage: canonicalUrl,
    url: canonicalUrl,
    headline: title,
    description,
    inLanguage,
    ...(image ? { image } : {}),
    ...(publishedTime ? { datePublished: publishedTime } : {}),
    author: { "@id": `${SITE_URL}/#person` },
    publisher: { "@id": `${SITE_URL}/#person` },
    isPartOf: { "@id": `${SITE_URL}/#website` },
    ...(tags.length ? { keywords: tags.join(", ") } : {}),
  };
} else {
  pageNode = {
    "@type": "WebPage",
    "@id": `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: title,
    description,
    inLanguage,
    isPartOf: { "@id": `${SITE_URL}/#website` },
    about: { "@id": `${SITE_URL}/#person` },
  };
}

// WebSite solo en la home (pageType === "profile").
const graph = {
  "@context": "https://schema.org",
  "@graph":
    pageType === "profile"
      ? [person, website, pageNode]
      : [person, pageNode],
};
---

<script type="application/ld+json" set:html={JSON.stringify(graph)} />

---
import { t, getAltLang, getLangSwitchUrl, getLangBase } from "../i18n/utils";
import type { Lang } from "../i18n/translations";

interface Props {
  lang?: Lang;
  currentPage?: string;
}

const { lang = "en", currentPage = "" } = Astro.props;
const altLang = getAltLang(lang);
const langSwitchUrl = getLangSwitchUrl(lang, currentPage);
const base = getLangBase(lang);

const navItems = [
  { title: t(lang, "nav.skills"), url: `${base}/#habilidades` },
  { title: t(lang, "nav.projects"), url: `${base}/#proyectos` },
  { title: t(lang, "nav.aboutMe"), url: `${base}/#sobre-mi` },
  { title: t(lang, "nav.contact"), url: `${base}/#contacto` },
  { title: t(lang, "nav.resume"), url: `${base}/resume` },
];
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2 select-none"
>
  <nav
    id="main-nav"
    aria-label={lang === "es" ? "Navegación principal" : "Primary navigation"}
    class="flex px-3 text-sm font-medium rounded-full text-gray-200 justify-center items-center gap-0.5"
  >
    {
      navItems.map((link) => (
        <a
          class="relative block px-2 py-2 transition hover:text-blue-400"
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }

    <!-- Language switcher -->
    <a
      href={langSwitchUrl}
      lang={altLang}
      hreflang={altLang}
      class="px-2 py-1 rounded-full text-xs font-bold border border-gray-600 hover:border-blue-400 transition-colors ml-1"
      aria-label={altLang === "en" ? "Switch to English" : "Cambiar a Español"}
      title={altLang === "en" ? "Switch to English" : "Cambiar a Español"}
    >
      {altLang.toUpperCase()}
    </a>
  </nav>
</header>

<style>
  nav {
    animation: nav-shadow 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-shadow {
    0% {
      background-color: rgba(255, 255, 255, 0);
    }
    to {
      box-shadow:
        0 10px 15px -3px rgba(0, 0, 0, 0.08),
        0 4px 6px -2px rgba(0, 0, 0, 0.04);
      background-color: var(--nav-shadow-bg, rgba(30, 30, 35, 0.75));
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
    }
  }
</style>
